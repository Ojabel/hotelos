VITE_API_BASE_URL=http://localhost:3000
# Optional local-only UI mode; defaults to backend. Does not configure staff authentication.
VITE_DATA_MODE=backend
# Explicit opt-in for local backend CLI tokens; production builds ignore this.
VITE_ENABLE_LOCAL_DEV_AUTH=false

# Firebase Web app configuration (public identifiers, never service-account data).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Development only; e.g. localhost:9099. Leave blank to use Firebase.
VITE_FIREBASE_AUTH_EMULATOR_HOST=
