NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:replace-me@localhost:5432/hotelos
DATABASE_POOL_MAX=5
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173
REQUEST_TIMEOUT_MS=10000
API_DOCS_ENABLED=true

# disabled keeps protected routes closed while the provider is unselected.
# For local authentication tests, use AUTH_MODE=development, a random 32+ char
# DEV_AUTH_SECRET, and the UUID of the locally provisioned organization.
AUTH_MODE=disabled
TENANT_ORGANIZATION_ID=
DEV_AUTH_SECRET=
DEV_AUTH_SUBJECT=local-owner

# Required when AUTH_MODE=oidc. Values must come from the selected provider's
# trusted server-side configuration; never accept a JWKS URL from a request.
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_JWKS_URI=
# Firebase standard mode uses Application Default Credentials (ADC). Set
# GOOGLE_APPLICATION_CREDENTIALS to a local, untracked service-account file only
# when ADC is unavailable. Emulator mode needs no service-account credentials.
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_MODE=standard
FIREBASE_AUTH_EMULATOR_HOST=

# Invitation mail (local capture is the non-production default).
APP_BASE_URL=http://localhost:5173
EMAIL_DELIVERY_MODE=local
EMAIL_FROM=HotelOS <no-reply@example.test>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
