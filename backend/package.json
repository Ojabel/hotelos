{
  "name": "@hotelos/backend",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "npm run prisma:generate && nest build",
    "start": "node dist/src/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "pretest": "npm run prisma:generate",
    "test": "jest --testPathIgnorePatterns=security-postgres.e2e-spec.ts",
    "pretest:e2e": "npm run prisma:generate",
    "test:watch": "jest --watch",
    "test:security": "npm run prisma:generate && jest --runInBand test/security-postgres.e2e-spec.ts",
    "test:e2e": "jest --runInBand test/foundation.e2e-spec.ts test/security-postgres.e2e-spec.ts",
    "prisma:generate": "prisma generate",
    "seed:access": "ts-node prisma/seed.ts",
    "seed:dev-tenant": "ts-node prisma/seed-dev-tenant.ts",
    "seed:dev-hotel": "ts-node prisma/seed-dev-hotel.ts",
    "auth:dev-token": "node scripts/create-dev-token.cjs",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:validate": "prisma validate"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.9",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.9",
    "@nestjs/platform-express": "^11.2.9",
    "@nestjs/swagger": "^11.4.8",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.2.3",
    "firebase-admin": "^14.5.1",
    "helmet": "^8.1.0",
    "joi": "^18.0.2",
    "jose": "^5.10.0",
    "nestjs-pino": "^4.4.1",
    "nodemailer": "10.5.0",
    "pg": "^8.16.3",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@nestjs/cli": "^11.0.12",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.2.9",
    "@types/express": "^5.0.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.5.0",
    "jest": "^30.2.0",
    "prettier": "^3.6.2",
    "prisma": "^7.10.1",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.51.0"
  }
}
