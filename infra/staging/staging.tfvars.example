project_id                       = "replace-with-approved-staging-project"
region                           = "africa-south1"
organization_id                  = "replace-with-existing-organization-uuid"
api_image                        = "africa-south1-docker.pkg.dev/PROJECT/REPOSITORY/hotelos-api@sha256:REPLACE"
frontend_origin                  = "https://staging.example.com"
